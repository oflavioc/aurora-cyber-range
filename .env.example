# Placeholders apenas. NUNCA coloque valor real aqui — este arquivo e versionado.
# O .env de verdade fica fora do Git (.gitignore) e e negado a agente.
#
# Exigido por 05_SECURITY_REQUIREMENTS.md secao 6 (".env.example versionado").
# Ausente desde a entrega original: era a P17, aberta na terceira auditoria e
# reconfirmada em cinco rodadas. A causa nao era esquecimento — o deny de
# `.env.*` em .claude/settings.json casava `.env.example` e tornava o arquivo
# incriavel por agente, apesar de CLAUDE.md permiti-lo explicitamente.

# Semente determinista da projecao de evidencia. DoD da Fase 1, nao desta.
RANDOM_SEED=0000000000

# Segredo de assinatura de token da aplicacao. Criptografia legitima da
# aplicacao e permitida por CLAUDE.md; gere localmente, nunca reutilize.
AURORA_JWT_SECRET=troque-por-valor-gerado-localmente

# Conexao do banco. Host, porta e credenciais sinteticos.
AURORA_DATABASE_URL=postgresql://aurora:senha-local@localhost:5432/aurora
