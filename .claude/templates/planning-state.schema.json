{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning-state de uma demanda",
  "description": "Estado da máquina de 7 fases da skill new-demand. Um arquivo por demanda em .claude/project-memory/planning-state/<slug>.json. Validado pelo stage `state`; lido a cada prompt pelo state-eval.",
  "type": "object",
  "required": ["demanda", "phase", "spec_dir"],
  "properties": {
    "demanda": { "type": "string", "description": "slug, igual ao diretório em specs/" },
    "phase": {
      "enum": ["refinement", "specify", "plan", "tasks", "red", "implement", "validate", "done"],
      "description": "fase corrente"
    },
    "spec_dir": { "type": "string", "description": "specs/NNN-slug" },
    "brief": { "type": "string", "description": "uma linha sobre a demanda" },
    "branch": { "type": "string", "description": "feature/NNN-slug (R14)" },
    "pr_url": { "type": "string", "description": "PR feature -> develop (aberto na Fase 6)" },
    "tdd_waiver": {
      "type": "object",
      "description": "válvula 2 da R3 — listada pelo compliance-audit",
      "required": ["motivo", "data"],
      "properties": {
        "motivo": { "type": "string" },
        "data": { "type": "string" }
      }
    },
    "refinement": { "$ref": "#/$defs/fase" },
    "specify": { "$ref": "#/$defs/fase" },
    "plan": { "$ref": "#/$defs/fase" },
    "tasks": { "$ref": "#/$defs/fase" },
    "red": {
      "allOf": [{ "$ref": "#/$defs/fase" }],
      "properties": {
        "commit": { "type": "string", "description": "sha do commit RED (R3 §4)" },
        "gates": { "type": "array", "items": { "type": "string" }, "description": "ids dos gates provados vermelhos" }
      }
    },
    "implement": {
      "allOf": [{ "$ref": "#/$defs/fase" }],
      "properties": {
        "waves_done": { "type": "array", "items": { "type": "integer" } },
        "pending": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validate": {
      "allOf": [{ "$ref": "#/$defs/fase" }],
      "properties": {
        "conformance": { "type": "string", "description": "score do spec-validate, ex.: '100%'" }
      }
    }
  },
  "$defs": {
    "fase": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "in_progress", "awaiting_approval", "approved", "proven", "done"] },
        "approved_at": { "type": "string", "description": "data da aprovação explícita do usuário" },
        "notes": { "type": "string" }
      }
    }
  }
}
